<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberShield</title>
    <style>
        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }

        body { 
            background: #0f172a; 
            font-family: Arial, sans-serif; 
            color: white; 
            overflow-x: hidden; 
        }

        body::before { 
            content: ""; 
            position: fixed; 
            width: 200%; 
            height: 200%; 
            background: radial-gradient(circle, #38bdf833 1px, transparent 1px); 
            background-size: 40px 40px; 
            animation: moveBg 15s linear infinite; 
            z-index: -1; 
        }

        @keyframes moveBg { 
            0% { transform: translate(0, 0); } 
            100% { transform: translate(-50px, -50px); } 
        }

        .container { 
            width: 90%; 
            max-width: 700px; 
            margin: 50px auto; 
            background: rgba(30, 41, 59, 0.95); 
            padding: 30px; 
            border-radius: 25px; 
            text-align: center; 
            box-shadow: 0 0 30px rgba(56, 189, 248, 0.3), 0 0 60px rgba(0, 0, 0, 0.5); 
            backdrop-filter: blur(10px); 
            animation: fadeIn 1s ease; 
        }

        @keyframes fadeIn { 
            from { opacity: 0; transform: translateY(30px); } 
            to { opacity: 1; transform: translateY(0); } 
        }

        .channel { 
            color: #ff0000; 
            font-size: 18px; 
            margin-bottom: 10px; 
            font-weight: bold; 
            letter-spacing: 1px; 
        }

        .logo { 
            font-size: 70px; 
            animation: float 3s ease-in-out infinite; 
            text-shadow: 0 0 20px #38bdf8; 
        }

        @keyframes float { 
            0%, 100% { transform: translateY(0); } 
            50% { transform: translateY(-10px); } 
        }

        h1 { 
            color: #38bdf8; 
            font-size: 50px; 
            margin-top: 10px; 
            text-shadow: 0 0 15px #38bdf8; 
        }

        .subtitle { 
            color: #cbd5e1; 
            margin-bottom: 25px; 
            font-size: 18px; 
        }

        input { 
            width: 90%; 
            padding: 16px; 
            border: none; 
            border-radius: 15px; 
            font-size: 18px; 
            background: #0f172a; 
            color: white; 
            outline: none; 
            border: 2px solid #38bdf8; 
            transition: 0.3s; 
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.3); 
        }

        input:focus { 
            transform: scale(1.02); 
            box-shadow: 0 0 20px #38bdf8; 
        }

        button { 
            margin-top: 20px; 
            padding: 14px 35px; 
            border: none; 
            border-radius: 15px; 
            background: linear-gradient(45deg, #38bdf8, #0ea5e9); 
            color: black; 
            font-size: 18px; 
            font-weight: bold; 
            cursor: pointer; 
            transition: 0.3s; 
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.5); 
        }

        button:hover { 
            transform: scale(1.05); 
            box-shadow: 0 0 25px #38bdf8; 
        }

        .about { 
            margin-top: 40px; 
            text-align: left; 
            background: #0f172a; 
            padding: 25px; 
            border-radius: 20px; 
            border: 1px solid #38bdf8; 
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.2); 
        }

        .about h2 { 
            color: #38bdf8; 
            margin-bottom: 10px; 
        }

        .about p { 
            line-height: 1.7; 
            color: #e2e8f0; 
        }

        .contact { 
            margin-top: 15px; 
            color: #38bdf8; 
            font-weight: bold; 
            font-size: 18px; 
        }

        .scan-animation { 
            width: 100%; 
            height: 6px; 
            margin-top: 25px; 
            border-radius: 10px; 
            overflow: hidden; 
            background: #1e293b; 
            display: none; 
        }

        .scan-bar { 
            width: 30%; 
            height: 100%; 
            background: #38bdf8; 
            animation: scan 1.5s linear infinite; 
        }

        @keyframes scan { 
            0% { transform: translateX(-100%); } 
            100% { transform: translateX(350%); } 
        }
    </style>
</head>
<body>

<div class="container">
    <div class="channel">✅Team Cyber Mindset</div>
    <div class="logo">🛡️</div>
    <h1>CyberShield</h1>
    <p class="subtitle">Advanced Fake Website & Phishing Detectorour (this version work on https only we will make changes in fucture)</p>
    
    <input type="text" id="url" placeholder="Enter your Website URL">
    <br>
    <button onclick="startScan()">🔍 Scan Website</button> 
    
    <div class="scan-animation" id="scanLoader">
        <div class="scan-bar"></div>
    </div>
    
    <div class="about">
        <h2>About CyberShield</h2>
        <p>CyberShield is a cyber security project designed to help users detect suspicious and phishing websites.
        
        This project was created by Devashish and Dikshit for Codorra 2026 Hackathon.</p>
        <div class="contact">📞 Contact: 9756210441</div>
    </div>
</div>

<script>
    function startScan() {
        let url = document.getElementById("url").value.trim().toLowerCase();
        let loader = document.getElementById("scanLoader");
        
        if (url === "") { 
            alert("Please enter a website URL."); 
            return; 
        }
        
        loader.style.display = "block";
        
        setTimeout(() => {
            loader.style.display = "none";
            alert("Scan Engine complete. Parsing parameters active...");
        }, 1500); 
    }
</script>

</body>
</html>
